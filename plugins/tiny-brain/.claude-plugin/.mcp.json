{
  "mcpServers": {
    "tiny-brain": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/entry.js"
      ],
      "env": {
        "TINY_BRAIN_HOME": "~/.tiny-brain",
        "TINY_BRAIN_LOG_LEVEL": "info",
        "TINY_BRAIN_DASHBOARD_STATIC_PATH": "${CLAUDE_PLUGIN_ROOT}/dashboard"
      }
    }
  }
}
