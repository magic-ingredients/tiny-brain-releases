#!/bin/sh
#
# Git pre-commit hook for TDD workflow
# Runs configured hook analysers from pipeline config, then delegates to commit-msg for tests
#
# Installed by: tiny-brain analyse
# To reinstall: tiny-brain hooks install
#

HOOKS_DIR=$(cd "$(dirname "$0")" && pwd)

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Run configured hook analysers from pipeline config (static analysis only).
# The CLI command `tiny-brain hooks run pre-commit` handles non-Node-safe
# semantics centrally — silent no-op in repos without package.json AND
# without an explicit reviewPipeline. That lets Rust/Go/Python/etc. repos
# install hooks and configure their own analysers (dep-audit, security,
# etc.) without the script-level gate blocking them.
# Steps with runsTests=true (e.g. coverage) are skipped here and run in
# commit-msg where the commit prefix is available for RED phase detection.
"$HOOKS_DIR/tiny-brain-run-hooks" pre-commit --skip-test-runners || exit 1

exit 0
