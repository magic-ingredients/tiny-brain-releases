#!/bin/sh
#
# Git pre-push hook for push pipeline
# Runs configured push pipeline analysers via hooks runner.
#
# Installed by: tiny-brain analyse
# To reinstall: tiny-brain hooks install
#

HOOKS_DIR=$(cd "$(dirname "$0")" && pwd)

# Run configured push-pipeline analysers via the shared helper.
"$HOOKS_DIR/tiny-brain-run-hooks" pre-push || exit 1

# Lifecycle-driven prune sweep — independent of the push pipeline.
# Reads its own config gate; never blocks the push.
if [ -x "$HOOKS_DIR/prune-on-push.sh" ]; then
  "$HOOKS_DIR/prune-on-push.sh" || true
fi

exit 0
