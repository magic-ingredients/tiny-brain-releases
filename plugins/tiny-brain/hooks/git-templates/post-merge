#!/bin/sh
#
# Git post-merge hook for progress.json re-synchronization
#
# After the team-ready-foundations migration, per-clone progress files
# live under <git-common-dir>/tiny-brain/ and are not git-tracked. The
# *team-visible* sources of truth (feature and fix markdown) DO live in
# the working tree under docs/, so a merge can change them and the
# per-clone progress mirror needs re-syncing.
#
# This hook scans the merged commits for changed feature/fix markdown,
# re-runs `tb task sync` on each, and exits. No git add / git commit is
# needed because the resulting progress.json files are operational state
# (gitignored).
#
# Installed by: tiny-brain analyse
# To reinstall: tiny-brain hooks install
#

# Resolve package manager exec command from analysis.json
HOOKS_DIR=$(cd "$(dirname "$0")" && pwd)
EXEC=$("$HOOKS_DIR/tiny-brain-exec" 2>/dev/null || echo "npx")

# Only react when the merge changed feature/fix markdown (the
# per-clone progress files are no longer in the working tree).
CHANGED_SOURCES=$(git diff-tree -r --name-only ORIG_HEAD HEAD 2>/dev/null \
  | grep -E '^(docs/prd/.+/features/.+\.md|docs/fixes/.+\.md)$')

if [ -z "$CHANGED_SOURCES" ]; then
  exit 0
fi

echo ""
echo "🧠 Feature/fix markdown changed during merge — re-syncing per-clone progress..."

echo "$CHANGED_SOURCES" | while IFS= read -r changed; do
  [ -n "$changed" ] || continue
  [ -f "$changed" ] || continue
  $EXEC tiny-brain task sync "$changed" 2>/dev/null || true
done

echo "✅ Per-clone progress re-synced (operational state, not committed)"
echo ""

exit 0
