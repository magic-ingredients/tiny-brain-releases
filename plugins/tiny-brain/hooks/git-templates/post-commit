#!/bin/sh
#
# Git post-commit hook for TDD progress tracking
# - records the commit via `_event commit` + derives the next step via `tb next`
#   for every tracked kind (fix / PRD / spike). Durable state is git-sourced.
#
# Installed by: tiny-brain analyse
# To reinstall: tiny-brain hooks install
#

# Resolve package manager exec command from analysis.json
HOOKS_DIR=$(cd "$(dirname "$0")" && pwd)
EXEC=$("$HOOKS_DIR/tiny-brain-exec" 2>/dev/null || echo "npx")

# Get the commit SHA
COMMIT_SHA=$(git rev-parse HEAD 2>/dev/null)
if [ -z "$COMMIT_SHA" ]; then
  exit 0
fi

# Get commit message
COMMIT_MSG=$(git log -1 --format=%B "$COMMIT_SHA" 2>/dev/null)
# Get commit subject (first line only)
COMMIT_SUBJECT=$(git log -1 --format='%s' "$COMMIT_SHA" 2>/dev/null)

# ─── Pipeline advancement ───

# Extract tracking context from commit message
CURRENT_FIX=$(echo "$COMMIT_MSG" | grep '^Fix:' | head -1 | sed 's/^Fix:[[:space:]]*//')
CURRENT_PRD=$(echo "$COMMIT_MSG" | grep '^PRD:' | head -1 | sed 's/^PRD:[[:space:]]*//')
CURRENT_FEATURE=$(echo "$COMMIT_MSG" | grep '^Feature:' | head -1 | sed 's/^Feature:[[:space:]]*//')
CURRENT_SPIKE=$(echo "$COMMIT_MSG" | grep '^Spike:' | head -1 | sed 's/^Spike:[[:space:]]*//')

# Tracking headers gate the per-task pipeline loop, not reconcile.
# Path C must run on every commit to catch reviews that landed outside
# the current commit's tracked work (different task, prior session, etc.).
HAS_HEADERS=""
if [ -n "$CURRENT_FIX" ]; then
  HAS_HEADERS="fix"
elif [ -n "$CURRENT_PRD" ] && [ -n "$CURRENT_FEATURE" ]; then
  HAS_HEADERS="prd"
elif [ -n "$CURRENT_SPIKE" ]; then
  HAS_HEADERS="spike"
fi

# Map commit prefix to pipeline agent name. Hoisted out of the
# RUN_PIPELINE block so the Path C reconcile case below can reuse
# the same source of truth — the two gates would otherwise need to
# keep two regexes in sync.
COMMIT_TYPE=$(echo "$COMMIT_SUBJECT" | sed -E 's/^([a-z]+)(\([^)]+\))?.*/\1/')

# ─── TB_RUN_ID-gated commit-event telemetry ───
#
# When run inside a target-spawned worker subprocess, the spawner sets
# TB_RUN_ID so this hook can append a `commit` RunEvent to the unified
# telemetry file. The append is gated, additive, and best-effort — a
# failure here never blocks the commit (or the pipeline-advancement
# block below).
#
# Path resolution is via `git rev-parse --git-common-dir` so it works
# from inside a worktree: the common dir always points at the main
# `.git`, and its parent is mainRepoRoot.
if [ -n "$TB_RUN_ID" ]; then
  # Shape guard. generateRunId emits `run_<base64url>` (URL-safe).
  # The spawner enforces this, but the hook lives a long time and
  # gets reused — defence-in-depth means we refuse anything outside
  # `[A-Za-z0-9_-]+` HERE so a malformed env value can't escape the
  # runs dir via path traversal (e.g. `../../etc/passwd`).
  case "$TB_RUN_ID" in
    *[!A-Za-z0-9_-]*|"")
      # Silent skip — telemetry attribution would be wrong anyway.
      ;;
    *)
      GIT_COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null)
      if [ -n "$GIT_COMMON_DIR" ]; then
        MAIN_REPO_ROOT=$(cd "$GIT_COMMON_DIR/.." 2>/dev/null && pwd)
        if [ -n "$MAIN_REPO_ROOT" ]; then
          TELEMETRY_DIR="$MAIN_REPO_ROOT/.tiny-brain/telemetry/runs"
          if mkdir -p "$TELEMETRY_DIR" 2>/dev/null; then
            # Build the JSON headers array via awk so the gsub-based
            # JSON escape covers backslash, double-quote, tab, and CR.
            # Order matters — backslash must escape FIRST or every
            # later replacement double-escapes its own backslashes.
            HEADERS_JSON=$(printf '%s' "$COMMIT_MSG" | awk '
              BEGIN { sep = ""; printf "[" }
              /^(Fix|PRD|Feature|Task|Spike):/ {
                s = $0
                gsub(/\\/, "\\\\", s)
                gsub(/"/,  "\\\"", s)
                gsub(/\t/, "\\t", s)
                gsub(/\r/, "\\r", s)
                printf "%s\"%s\"", sep, s
                sep = ","
              }
              END { printf "]" }
            ')

            # ISO-8601 UTC with millisecond field fixed at `.000`.
            # macOS `date` lacks `%N`; rather than degrade to second
            # precision on macOS while Linux quietly diverges, both
            # platforms produce identical `.000Z` output and ordering
            # is by file position, not by ts. Downstream consumers
            # depend on this fixed-zero contract.
            TS=$(date -u +%Y-%m-%dT%H:%M:%S).000Z

            # COMMIT_TYPE, COMMIT_SHA are JSON-safe by construction
            # (matched against `[a-z]+` and hex). TB_RUN_ID was
            # validated above. HEADERS_JSON was awk-escaped. POSIX
            # `O_APPEND` on a single sub-page write is atomic —
            # matches RunTelemetryStore's contract.
            if ! printf '{"type":"commit","runId":"%s","sha":"%s","prefix":"%s","headers":%s,"ts":"%s"}\n' \
                "$TB_RUN_ID" "$COMMIT_SHA" "$COMMIT_TYPE" "$HEADERS_JSON" "$TS" \
                >> "$TELEMETRY_DIR/$TB_RUN_ID.jsonl" 2>/dev/null; then
              # Silent-on-success, diagnostic-on-failure. Hook stderr
              # never blocks the commit (best-effort contract) but
              # gives field operators a thread to pull on when
              # telemetry stops appearing.
              >&2 echo "tb: telemetry append failed ($TELEMETRY_DIR/$TB_RUN_ID.jsonl)"
            fi
          else
            >&2 echo "tb: telemetry skipped — mkdir failed ($TELEMETRY_DIR)"
          fi
        fi
      fi
      ;;
  esac
fi

# ─── Live overlay + run-record via the single _event writer (T3) ───
#
# `_event commit` records the landed commit through the one event writer: it
# maps the prefix to the live overlay (test ⇒ red, feat/fix ⇒ green, refactor ⇒
# commit.tracked, manual ⇒ task.completed, supersede ⇒ task.superseded; revert:
# and untracked ⇒ no overlay), resolves each Task: header's UUID, and — inside a
# `tb run` worker (TB_RUN_ID) — mirrors the commit sha onto the run record for
# the record types. This is the record half the deprecated `pipeline --agent
# --sha` advance performed. All tracked kinds record here — fix / PRD and, since
# retire-deprecated-pipeline-command T1 added the Spike: overlay branch, spikes
# too. Best-effort — durable state is git-derived, so a failure here must never
# fail the commit.
# shellcheck disable=SC2086
$EXEC tiny-brain _event commit "$COMMIT_SHA" "$COMMIT_MSG" 2>/dev/null || true

# Skip the per-task loop unless headers AND a tracked commit type are present.
RUN_PIPELINE=""
case "$COMMIT_TYPE" in
  test|feat|fix|refactor)
    [ -n "$HAS_HEADERS" ] && RUN_PIPELINE="1"
    ;;
esac

if [ -n "$RUN_PIPELINE" ]; then
  # ── Record + derive (event-emit-consolidation T3; spike repoint
  #    retire-deprecated-pipeline-command T3) ──
  # The commit was already recorded by `_event commit` above — it records the
  # fix / PRD / spike overlay per Task: header (the spike branch landed with
  # retire-deprecated-pipeline-command T1). All tracked kinds now derive the
  # next-step instruction read-only per Task: header via `tb next`, which runs
  # after the record so the projection reflects the landed commit. No
  # `pipeline --agent` advance on any path; `pipeline` survives only as the
  # adversarial gate-advancer the review flow calls directly.
  echo "$COMMIT_MSG" | grep '^Task:' | sed 's/^Task:[[:space:]]*//' | while IFS= read -r TASK_LINE; do
    if [ -n "$TASK_LINE" ]; then
      # Build tracking args as positional parameters — no eval / re-parse, so
      # shell metacharacters in TASK_LINE etc. are treated as literal data.
      set -- --task-id "$TASK_LINE"
      if [ "$HAS_HEADERS" = "fix" ]; then
        set -- "$@" --fix "$CURRENT_FIX"
      elif [ "$HAS_HEADERS" = "prd" ]; then
        set -- "$@" --prd "$CURRENT_PRD" --feature "$CURRENT_FEATURE"
      elif [ "$HAS_HEADERS" = "spike" ]; then
        set -- "$@" --spike "$CURRENT_SPIKE"
      fi

      # Manual tasks complete via markdown + `tb task sync`, not the TDD phase
      # model — skip their misleading next-step. The read-only type probe is
      # served by `tb next --print-pipeline-type`; `2>/dev/null` swallows tb
      # errors so a probe failure falls through to a harmless `tb next`.
      # shellcheck disable=SC2086
      TASK_PIPELINE_TYPE=$($EXEC tiny-brain next "$@" --print-pipeline-type 2>/dev/null | tr -d '[:space:]')
      if [ "$TASK_PIPELINE_TYPE" = "manual" ]; then
        continue
      fi

      # $EXEC intentionally unquoted — may be a multi-word prefix like "pnpm
      # exec" — but everything after is quoted argv so headers reach tb verbatim.
      # shellcheck disable=SC2086
      $EXEC tiny-brain next "$@" 2>/dev/null || true
    fi
  done
fi

# ─── Path C: post-commit reconcile ───
#
# Belt-and-braces fallback. Scans <git-common-dir>/tiny-brain/reviews/ and
# advances any (gate, sha) whose decision hasn't been recorded — covers the case where
# the agent or watcher missed its --decision call. Runs on every commit
# (tracked or not) so a review file landed during a prior session still
# advances at the next opportunity.
#
# Idempotent: anything already advanced is a no-op. Reminder output flows
# through this hook's stdout into the commit's system-reminder channel —
# but only for tracked commit types where the operator is plausibly
# mid-review-cycle. chore/docs/build/ci/style commits can't have produced
# reviewable code, so they get --quiet: bookkeeping still runs (advancing
# any stuck records) but operator-facing reminders are suppressed.
# See docs/fixes/reconcile-reminders-fire-on-chore-commits.md.
#
# Hook contract: never fail the commit; reconcile swallows its own errors.
#
# Scope reminders to the current commit:
# - `--scope-sha` matches review files whose persisted sha equals
#   the just-landed commit. Closes the canonical case where this
#   commit IS the review subject.
# - `--scope-fix <id>` matches reviews for any task under the same
#   fix the current commit is on. Closes the case where a prior
#   commit on the same fix left a review pending and the operator
#   is still working it.
#
# Advances still run for every live review (state bookkeeping
# unchanged); only the operator-facing reminder emission is
# narrowed. Manual `tiny-brain _reconcile` (no scope flags) keeps
# its fire-everything debugging surface.
case "$COMMIT_TYPE" in
  test|feat|fix|refactor)
    set -- --scope-sha "$COMMIT_SHA"
    if [ "$HAS_HEADERS" = "fix" ] && [ -n "$CURRENT_FIX" ]; then
      set -- "$@" --scope-fix "$CURRENT_FIX"
    elif [ "$HAS_HEADERS" = "prd" ] && [ -n "$CURRENT_PRD" ]; then
      set -- "$@" --scope-prd "$CURRENT_PRD"
    fi
    # shellcheck disable=SC2086
    $EXEC tiny-brain _reconcile "$@" 2>/dev/null || true
    ;;
  *)
    # shellcheck disable=SC2086
    $EXEC tiny-brain _reconcile --quiet 2>/dev/null || true
    ;;
esac

exit 0
