{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "tiny-brain dashboard start --if-not-running",
            "timeout": 30,
            "statusMessage": "Starting Tiny Brain dashboard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PLUGIN_ROOT}/hooks/agent-lease-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${PLUGIN_ROOT}/hooks/agent-lease-renew.sh"
          }
        ]
      }
    ]
  }
}
